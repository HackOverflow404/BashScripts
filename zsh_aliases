# ===========================================================================
# system update — Arch / Omarchy
# ===========================================================================
update() (
    local errors=0

    # Exit on interruption without leaking traps into the calling shell
    trap 'exit 130' INT
    trap 'exit 143' TERM

    print -P "\n%F{blue}==> OMARCHY + PACMAN + AUR%f"
    omarchy update -y || { print -P "%F{red}omarchy-update failed%f"; (( errors++ )) }

    if command -v flatpak &> /dev/null; then
        print -P "\n%F{blue}==> FLATPAK%f"
        flatpak update -y || { print -P "%F{red}Flatpak failed%f"; (( errors++ )) }
    fi

    if command -v fwupdmgr &> /dev/null; then
        print -P "\n%F{blue}==> FIRMWARE%f"
        fwupdmgr refresh --force && fwupdmgr update --assume-yes || print -P "%F{yellow}Firmware skipped or unavailable (non-fatal)%f"
    fi

    print -P "\n%F{blue}==> MISE%f"
    mise up || { print -P "%F{red}mise up failed%f"; (( errors++ )) }

    print -P "\n%F{blue}==> OH-MY-ZSH%f"
    LANG= git -C "${ZSH:-$HOME/.oh-my-zsh}" pull --rebase --autostash || { print -P "%F{red}oh-my-zsh update failed%f"; (( errors++ )) }

    if command -v npm &> /dev/null; then
        print -P "\n%F{blue}==> NPM GLOBAL%f"
        npm update -g 2>&1 | grep -Ev "^npm (warn|notice)"
        local npm_rc=${pipestatus[1]}
        (( npm_rc != 0 )) && { print -P "%F{red}NPM failed%f"; (( errors++ )) }
    fi

    if command -v rustup &> /dev/null; then
        print -P "\n%F{blue}==> RUST%f"
        rustup update || { print -P "%F{red}rustup update failed%f"; (( errors++ )) }
        command -v cargo-install-update &> /dev/null && { cargo install-update -a || { print -P "%F{red}Cargo failed%f"; (( errors++ )) } }
    fi

    print -P "\n%F{blue}==> DOTFILES%f"
    if ! chezmoi re-add; then
        print -P "%F{red}chezmoi re-add failed%f"; (( errors++ ))
    else
        chezmoi git -- add -A || { print -P "%F{red}Dotfiles staging failed%f"; return 1; }
        if ! chezmoi git -- diff --cached --quiet; then
            chezmoi git -- commit -m "chore: sync dotfiles" && \
                chezmoi git -- push || { print -P "%F{red}Dotfiles push failed%f"; (( errors++ )) }
        else
            print "Nothing to sync."
        fi
    fi

    trap - INT TERM
    (( errors == 0 )) && print -P "\n%F{green}==> All done!%f" || print -P "\n%F{yellow}==> Done with $errors error(s).%f"

    return $(( errors > 0 ))
)
